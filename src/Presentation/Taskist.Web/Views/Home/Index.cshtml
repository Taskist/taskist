@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/dashboard/dashboard.css" asp-append-version="true" />
}

@section PageScripts {
    <script src="~/js/pages/dashboard/welcome-card.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/dashboard.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("Sections/_WelcomeCard")

<div id="dashboardContent" data-content-url="@Url.Action("DashboardContent", "Home")">
    @await Component.InvokeAsync("DashboardWidgets")
</div>
