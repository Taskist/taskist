@model ChangePasswordModel
@{
    Layout = "~/Views/Shared/_LayoutPartial.cshtml";
}

<form asp-action="ChangePassword" data-ajax="true" data-ajax-method="post" data-ajax-begin="ajaxBegin" data-ajax-success="ajaxSuccess" data-ajax-complete="ajaxComplete">
    <div class="validation-errors"></div>
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <wc-label asp-for="CurrentPassword" />
                <input asp-for="CurrentPassword" class="form-control form-control-maxlength" autocomplete="off" maxlength="100" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <wc-label asp-for="NewPassword" />
                <input asp-for="NewPassword" class="form-control form-control-maxlength" autocomplete="off" maxlength="100" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <wc-label asp-for="ConfirmNewPassword" />
                <input asp-for="ConfirmNewPassword" class="form-control form-control-maxlength" autocomplete="off" maxlength="100" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <partial name="_ModalButton" />
</form>