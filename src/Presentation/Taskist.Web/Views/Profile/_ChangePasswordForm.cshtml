@model ChangePasswordModel
<form asp-action="ChangePassword" data-ajax="true" data-ajax-method="post" data-ajax-begin="ajaxBegin"
      data-ajax-success="ajaxSuccess" data-ajax-complete="ajaxComplete">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <wc-label asp-for="CurrentPassword" />
                <input asp-for="CurrentPassword" class="form-control form-control-maxlength track" autocomplete="off" maxlength="100" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <wc-label asp-for="NewPassword" />
                <input asp-for="NewPassword" class="form-control form-control-maxlength track" autocomplete="off" maxlength="100" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <wc-label asp-for="ConfirmPassword" />
                <input asp-for="ConfirmPassword" class="form-control form-control-maxlength track" autocomplete="off" maxlength="100" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="float-end">
        <button type="submit" class="btn btn-primary btn-sm savebtn">
            <i class="fas fa-save me-1"></i>@Localize("Button.Save")
        </button>
        <button type="button" class="btn btn-secondary close-form btn-sm">
            <i class="fas fa-ban me-1"></i>@Localize("Button.Cancel")
        </button>
    </div>
</form>