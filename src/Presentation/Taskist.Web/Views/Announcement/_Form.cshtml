@model AnnouncementModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Title" />
            <input asp-for="Title" class="form-control form-control-maxlength" autocomplete="off" maxlength="200" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Body" />
            <textarea asp-for="Body" id="annBody" class="form-control rt-body"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <wc-label asp-for="Type" />
            <select asp-for="Type" asp-items="Model.AvailableTypes" class="form-control select2"></select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <wc-label asp-for="Severity" />
            <select asp-for="Severity" asp-items="Model.AvailableSeverities" class="form-control select2"></select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <wc-label asp-for="Audience" />
            <select asp-for="Audience" asp-items="Model.AvailableAudiences" id="annAudience" class="form-control select2"></select>
        </div>
    </div>
    <div class="col-md-12 d-none" id="annRolesWrap">
        <div class="mb-3">
            <wc-label asp-for="SelectedRoleIds" />
            <select asp-for="SelectedRoleIds" asp-items="Model.AvailableRoles" multiple class="form-control select2"></select>
        </div>
    </div>
    <div class="col-md-2">
        <div class="mb-3">
            <wc-label asp-for="ValidFrom" />
            <input asp-for="ValidFrom" asp-format="{0:dd-MMM-yyyy}" class="form-control datepicker-from" autocomplete="off" />
            <span asp-validation-for="ValidFrom" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="mb-3">
            <wc-label asp-for="ValidTo" />
            <input asp-for="ValidTo" asp-format="{0:dd-MMM-yyyy}" class="form-control datepicker-to" autocomplete="off" />
            <span asp-validation-for="ValidTo" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="mb-3">
            <wc-label asp-for="DisplayOrder" />
            <input asp-for="DisplayOrder" class="form-control" type="number" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3 d-flex flex-column gap-2 pt-4">
            <label class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="RequiresAcknowledgement">
                <wc-label asp-for="RequiresAcknowledgement" />
            </label>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3 d-flex flex-column gap-2 pt-4">
            <label class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="Active">
                <wc-label asp-for="Active" />
            </label>
        </div>
    </div>
</div>
