@model AnnouncementModel
@{
    ViewData["Title"] = Localize("AnnouncementPage.Title");
}

<div class="card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            @await Html.PartialAsync("_Form", Model)
        </div>
        <div class="card-footer text-end pt-3 pb-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>@Localize("Button.Save")</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-ban me-1"></i>@Localize("Button.Back")</a>
        </div>
    </form>
</div>

@section PageScripts {
    <script src="~/js/pages/announcement/announcement-form.js" asp-append-version="true"></script>
}
