@model LoginModel
@{
	ViewData["Title"] = "Login";
	Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/pages/account/login.css" asp-append-version="true" />
}

<div class="login-card">
	<div class="login-brand d-none d-lg-flex">
		<div class="login-eyebrow">Taskist</div>
		<div class="login-brand-content">
			<h1 class="login-brand-title">Welcome to Taskist</h1>
			<p class="login-brand-tagline">Plan, track and ship your work &mdash; all in one place.</p>
			<ul class="login-features">
				<li><i class="fas fa-tasks"></i> Backlog &amp; sprints at a glance</li>
				<li><i class="fas fa-bug"></i> Track bugs, tasks &amp; change requests</li>
				<li><i class="fas fa-chart-line"></i> Insightful dashboards &amp; reports</li>
			</ul>
		</div>
		<div class="login-brand-footer">
			<span>Need access? Contact your administrator.</span>
			<span class="login-brand-version">v 1.0 alpha</span>
		</div>
		<span class="login-brand-blob login-brand-blob-1"></span>
		<span class="login-brand-blob login-brand-blob-2"></span>
	</div>

	<div class="login-form">
		<div class="login-form-inner">
			<div class="login-form-logo">
				<img src="~/images/brand/logo.png" alt="Taskist" height="44" />
			</div>
			<div class="login-form-header">
				<h2 id="loginGreeting">Welcome back</h2>
				<p>Sign in to continue to Taskist.</p>
			</div>

			<form asp-action="Login" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off" id="loginForm">
				<div asp-validation-summary="ModelOnly" class="login-error"></div>
				<div class="mb-3">
					<label asp-for="Email" class="form-label"></label>
					<div class="login-input">
						<i class="fas fa-user login-input-icon"></i>
						<input asp-for="Email" type="text" class="form-control" placeholder="Enter your username" autocomplete="username" autofocus />
					</div>
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>

				<div class="mb-2">
					<label asp-for="Password" class="form-label"></label>
					<div class="login-input">
						<i class="fas fa-lock login-input-icon"></i>
						<input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" id="Password" />
						<button type="button" class="login-toggle" id="togglePassword" tabindex="-1" aria-label="Show password"><i class="fas fa-eye"></i></button>
					</div>
					<span asp-validation-for="Password" class="text-danger"></span>
					<div class="login-caps" id="capsHint"><i class="fas fa-exclamation-triangle"></i> Caps Lock is on</div>
				</div>

				<div class="login-form-row">
					<div class="form-check">
						<input class="form-check-input" asp-for="RememberMe" type="checkbox" />
						<label class="form-check-label" asp-for="RememberMe"></label>
					</div>
				</div>

				<button type="submit" class="btn btn-primary login-submit">
					Sign In <i class="fas fa-arrow-right ms-1"></i>
				</button>

				<p class="login-copy">&copy; @DateTime.Now.Year Taskist</p>
			</form>
		</div>
	</div>
</div>

@section PageScripts {
	<script src="~/js/pages/account/login.js" asp-append-version="true"></script>
}
