@model ForgotPasswordModel
@{
	ViewData["Title"] = "Forgot Password";
	Layout = "~/Views/Shared/_LayoutLogin.cshtml";
	var sent = TempData["ForgotPasswordSent"] != null;
	var throttled = Context.Request.Query["throttled"] == "1";
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<div class="login-card">
	<div class="login-form">
		<div class="login-form-inner">
			<div class="login-form-header">
				<h2>Forgot password</h2>
				<p>Enter your email and we'll send you a link to reset your password.</p>
			</div>

			@if (sent)
			{
				<div class="alert alert-success">
					If an account exists for that email, a password reset link has been sent. The link expires shortly, so please check your inbox soon.
				</div>
				<div class="login-form-row">
					<a class="login-forgot" asp-route="Login"><i class="fas fa-arrow-left me-1"></i>Back to sign in</a>
				</div>
			}
			else
			{
				@if (throttled)
				{
					<div class="alert alert-warning">Too many attempts. Please wait a few minutes and try again.</div>
				}
				<form asp-action="ForgotPassword" method="post" autocomplete="off">
					<div asp-validation-summary="ModelOnly" class="login-error"></div>

					<div class="mb-3">
						<label asp-for="Email" class="form-label"></label>
						<div class="login-input">
							<i class="fas fa-user login-input-icon"></i>
							<input asp-for="Email" type="text" class="form-control" placeholder="Enter your email" autocomplete="username" autofocus />
						</div>
						<span asp-validation-for="Email" class="text-danger"></span>
					</div>

					<button type="submit" class="btn btn-primary login-submit">
						<span>Send reset link <i class="fas fa-paper-plane ms-1"></i></span>
					</button>

					<div class="login-form-row mt-3">
						<a class="login-forgot" asp-route="Login"><i class="fas fa-arrow-left me-1"></i>Back to sign in</a>
					</div>
				</form>
			}
		</div>
	</div>
</div>
