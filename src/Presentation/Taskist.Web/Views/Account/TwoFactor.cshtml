@model TwoFactorLoginModel
@inject Taskist.Service.Localization.ILocalizationService LocalizationService
@functions {
	private async Task<string> TextAsync(string key, string fallback)
	{
		var value = await LocalizationService.GetResourceAsync(key);
		return string.IsNullOrWhiteSpace(value) || string.Equals(value, key, StringComparison.OrdinalIgnoreCase) ? fallback : value;
	}
}
@{
	ViewData["Title"] = "Two-factor sign-in";
	Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

<div class="login-card login-card--narrow">
	<div class="login-form">
		<div class="login-form-inner">
			<div class="login-form-logo">
				<img src="~/images/brand/logo.png" alt="Taskist" />
			</div>
			<div class="login-form-header">
				<h2>@await TextAsync("Login.TwoFactor.Title", "Two-factor sign-in")</h2>
				<p class="js-tf-intro-code" hidden="@Model.IsRecoveryMode">@await TextAsync("Login.TwoFactor.Intro", "Enter the 6-digit code from your authenticator app.")</p>
				<p class="js-tf-intro-recovery" hidden="@(!Model.IsRecoveryMode)">@await TextAsync("Login.TwoFactor.RecoveryIntro", "Enter one of the recovery codes you saved when you set up two-factor sign-in. Each code works once.")</p>
			</div>

			@if (!string.IsNullOrEmpty(Model.ErrorMessage))
			{
				<div class="login-error" role="alert">@Model.ErrorMessage</div>
			}

			<form asp-action="TwoFactor" method="post" autocomplete="off" id="twoFactorForm">
				<input type="hidden" name="UseRecoveryCode" value="@(Model.IsRecoveryMode ? "true" : "false")" class="js-tf-mode" />
				<div class="mb-3">
					<label for="Code" class="form-label">
						<span class="js-tf-intro-code" hidden="@Model.IsRecoveryMode">@await TextAsync("Login.TwoFactor.Code", "Authentication code")</span>
						<span class="js-tf-intro-recovery" hidden="@(!Model.IsRecoveryMode)">@await TextAsync("Login.TwoFactor.RecoveryCode", "Recovery code")</span>
					</label>
					<div class="login-input">
						<i class="fas fa-shield-halved login-input-icon"></i>
						<input asp-for="Code" type="text" class="form-control login-code-input" autocomplete="one-time-code"
							   inputmode="@(Model.IsRecoveryMode ? "text" : "numeric")" maxlength="20" required
							   placeholder="@(Model.IsRecoveryMode ? "xxxxx-xxxxx" : "123456")" />
					</div>
				</div>

				@if (Model.RememberDeviceDays > 0)
				{
					<div class="form-check mb-3">
						<input class="form-check-input" id="RememberDevice" name="RememberDevice" type="checkbox" value="true" checked="@(Model.RememberDevice == true)" />
						<label class="form-check-label" for="RememberDevice">@string.Format(await TextAsync("Login.TwoFactor.RememberDevice", "Don't ask again on this device for {0} days"), Model.RememberDeviceDays)</label>
					</div>
				}

				<button type="submit" class="btn btn-primary login-submit">@await TextAsync("Login.TwoFactor.Verify", "Verify")</button>

				<p class="login-local-link">
					<a href="#" class="js-tf-toggle js-tf-intro-code" hidden="@Model.IsRecoveryMode">@await TextAsync("Login.TwoFactor.UseRecovery", "Can't use your app? Use a recovery code")</a>
					<a href="#" class="js-tf-toggle js-tf-intro-recovery" hidden="@(!Model.IsRecoveryMode)">@await TextAsync("Login.TwoFactor.UseApp", "Use your authenticator app instead")</a>
				</p>
				<p class="login-local-link"><a asp-action="Login">@await TextAsync("Login.TwoFactor.Cancel", "Cancel and sign in again")</a></p>
			</form>
		</div>
	</div>
</div>

@section PageScripts {
	<script src="~/js/pages/login-two-factor.js" asp-append-version="true"></script>
}
