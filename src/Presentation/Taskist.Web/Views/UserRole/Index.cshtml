@{
    ViewData["Title"] = Localize("UserRolePage.Title");
}

@section PageStyles {
    <link href="~/css/pages/userrole/permission.css" rel="stylesheet" asp-append-version="true" />
}

@section PageScripts {
    <script src="~/js/pages/userrole/permission.js" asp-append-version="true"></script>
}

@await Html.PartialAsync("DataTable", new DataTableModel
{
    Name = "UserRoleGrid",
    Title = Localize("UserRolePage.Title").Text,
    LengthChangeLabel = Localize("Grid.LengthChangeLabel").Text,
    SearchLabel = Localize("Grid.SearchLabel").Text,
    SearchPlaceholder = Localize("Grid.SearchPlaceholder").Text,
    ZeroRecordsLabel = Localize("Grid.ZeroRecords").Text,
    FooterInfoLabel = Localize("Grid.FooterInfo").Text,
    FooterInfoWhenEmptyLabel = Localize("Grid.FooterInfoWhenEmpty").Text,
    UrlRead = Url.Action("DataRead"),
    HeaderActions = new List<ActionModel>
    {
        new ActionModel {
            Title = Localize("Button.AddNew").Text,
            Url = Url.Action("Create"),
            Text = Localize("Button.AddNew").Text,
            Icon = "fas fa-plus",
            HyperLinkType = HyperLinkType.BUTTON_TEXT_ICON,
            NavigationType = NavigationType.OFFCANVAS,
            ButtonColor = ButtonColor.PRIMARY
        }
    },
    ColumnActions = new List<ActionModel>
    {
        new ActionModel {
            Title = Localize("Button.Edit").Text,
            Url = Url.Action("Edit"),
            Text = Localize("Button.Edit").Text,
            Icon = "far fa-edit",
            ReferenceParameter = "Id",
            HyperLinkType = HyperLinkType.HYPERLINK_TEXT_ICON,
            NavigationType = NavigationType.OFFCANVAS,
            ButtonColor = ButtonColor.PRIMARY
        },
        new ActionModel {
            Title = Localize("UserRoleGrid.Button.Permission").Text,
            Url = Url.Action("Permission"),
            Text =  Localize("UserRoleGrid.Button.Permission").Text,
            Icon = "fas fa-shield-alt",
            ReferenceParameter = "Id",
            HyperLinkType = HyperLinkType.HYPERLINK_TEXT_ICON,
            NavigationType = NavigationType.OFFCANVAS,
            ButtonColor = ButtonColor.PRIMARY
        }
    },
    Columns = new List<ColumnModel>
    {
        new ColumnModel { Title = Localize("UserRoleGrid.Name").Text, DataColumn = "Name" },
        new ColumnModel { Title = Localize("UserRoleGrid.SystemName").Text, DataColumn = "SystemName" },
        new ColumnModel { Title = Localize("UserRoleGrid.Description").Text, DataColumn = "Description" },
        new ColumnModel { Title = Localize("UserRoleGrid.SystemDefined").Text, DataColumn = "SystemDefined", Conditions = new List<ColumnConditionModel>{
            new ColumnConditionModel { Value = "true", Operator = Operator.EQUAL, Icon = "fa fa-check", TextColor = "#2eb85c" },
            new ColumnConditionModel { Value = "false", Operator = Operator.EQUAL, Icon = "fa fa-times", TextColor = "#e55353" }
        }},
        new ColumnModel { Title = Localize("UserRoleGrid.Active").Text, DataColumn = "Active", Conditions = new List<ColumnConditionModel>{
            new ColumnConditionModel { Value = "true", Operator = Operator.EQUAL, Icon = "fa fa-check", TextColor = "#2eb85c" },
            new ColumnConditionModel { Value = "false", Operator = Operator.EQUAL, Icon = "fa fa-times", TextColor = "#e55353" }
        }}
    }
})
