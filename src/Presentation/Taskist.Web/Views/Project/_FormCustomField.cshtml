@model CustomFieldModel
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ProjectId" />
<div class="validation-errors"></div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Label" />
            <input asp-for="Label" class="form-control form-control-maxlength js-custom-field-label" autocomplete="off" maxlength="100" data-key-prefix="@Model.ProjectName" />
            <span asp-validation-for="Label" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ResourceKey" />
            <input asp-for="ResourceKey" class="form-control form-control-maxlength" autocomplete="off" readonly />
            <span asp-validation-for="ResourceKey" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="FieldType" />
            <select class="form-control select2" data-style="btn-default" asp-for="FieldType" asp-items="Html.GetEnumSelectList<FieldType>()"></select>
            <span asp-validation-for="FieldType" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="ColumnClass" />
            <select class="form-control select2" data-style="btn-default" asp-for="ColumnClass" asp-items="Model.AvailableColumnClasses"></select>
            <span asp-validation-for="ColumnClass" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="DisplayOrder" />
            <input asp-for="DisplayOrder" class="form-control" type="number" min="0" max="9999" step="1" autocomplete="off" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Slot" />
            <select class="form-control select2" data-style="btn-default" asp-for="Slot" asp-items="Model.AvailableSlots"></select>
            <span asp-validation-for="Slot" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Options" />
            <textarea asp-for="Options" class="form-control form-control-maxlength" autocomplete="off" rows="2"></textarea>
            <span asp-validation-for="Options" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <label class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" asp-for="Mandatory">
                <wc-label asp-for="Mandatory" />
            </label>
        </div>
    </div>
</div>
