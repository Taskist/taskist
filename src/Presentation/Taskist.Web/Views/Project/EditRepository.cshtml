@model ProjectRepositoryModel
@{
    Layout = "~/Views/Shared/_LayoutPartial.cshtml";
}

@section Scripts {
    <script src="~/js/pages/masters/project-repository.js" asp-append-version="true"></script>
}

<form asp-action="EditRepository" data-ajax="true" data-ajax-method="post" data-ajax-begin="ajaxBegin" data-ajax-success="ajaxSuccess" data-ajax-complete="ajaxComplete">
    @await Html.PartialAsync("_FormRepository", Model)
    <partial name="_ModalButton" />
</form>
