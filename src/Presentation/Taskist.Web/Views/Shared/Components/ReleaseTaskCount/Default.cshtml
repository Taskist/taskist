@model List<ReleaseVsTaskDto>

<div class="wp-card h-100">
    <div class="wp-card__head"><i class="fas fa-rocket me-2"></i>@Localize("Dashboard.ReleaseProgress").Text</div>
    <div class="wp-card__body">
        @if (!Model.Any())
        {
            <wp-empty-state class="wp-empty--widget" icon="fas fa-rocket" size="compact" tone="info" heading="@Localize("Dashboard.NoData").Text" text="@Localize("EmptyState.Widget.NoData").Text"></wp-empty-state>
        }
        else
        {
            <div class="wp-release">
                @foreach (var r in Model)
                {
                    var total = r.OpenTasks + r.ClosedTasks;
                    var pct = total > 0 ? (int)Math.Round(r.ClosedTasks * 100.0 / total) : 0;
                    <div class="wp-release__row">
                        <div class="wp-release__top">
                            <span class="wp-release__name">@r.ReleaseVersion</span>
                            <span class="wp-release__count">@r.ClosedTasks / @total</span>
                        </div>
                        <div class="wp-release__bar"><span style="width:@(pct)%"></span></div>
                    </div>
                }
            </div>
        }
    </div>
</div>
