@model CardWithCountsModel
@{
    var accents = new[] { "wp-stat--teal", "wp-stat--amber", "wp-stat--red", "wp-stat--green" };
    var icons = new[] { "fa-layer-group", "fa-list-check", "fa-rotate-left", "fa-circle-check" };
    var i = 0;
}

@foreach (var card in Model.Cards)
{
    <a asp-action="Index" asp-controller="Backlog" asp-route-filter="@card.FilterMode" asp-route-project="@Model.SelectedProjectId" class="wp-stat @accents[i % accents.Length]">
        <span class="wp-stat__icon"><i class="fas @icons[i % icons.Length]"></i></span>
        <span class="wp-stat__value">@card.Count</span>
        <span class="wp-stat__label">@card.Name</span>
    </a>
    i++;
}
