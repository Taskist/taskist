@model List<WorkloadDto>

<div class="wp-card h-100">
    <div class="wp-card__head"><i class="fas fa-people-group me-2"></i>@Localize("Dashboard.AssigneeWorkload").Text</div>
    <div class="wp-card__body">
        @if (!Model.Any())
        {
            <wp-empty-state class="wp-empty--widget" icon="fas fa-users" size="compact" tone="info" heading="@Localize("Dashboard.NoData").Text" text="@Localize("EmptyState.Widget.NoData").Text"></wp-empty-state>
        }
        else
        {
            <div class="chart-container">
                <canvas data-chart="workloadBar"></canvas>
                <script type="application/json" class="chart-payload">@Html.Raw(Json.Serialize(new { labels = Model.Select(m => m.Assignee), open = Model.Select(m => m.Open), closed = Model.Select(m => m.Closed) }))</script>
            </div>
        }
    </div>
</div>
