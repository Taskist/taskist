@model List<TrendPointDto>

<div class="wp-card h-100">
    <div class="wp-card__head"><i class="fas fa-chart-line me-2"></i>@Localize("Dashboard.CreatedVsResolved").Text</div>
    <div class="wp-card__body">
        @if (!Model.Any())
        {
            <wp-empty-state class="wp-empty--widget" icon="fas fa-chart-line" size="compact" tone="info" heading="@Localize("Dashboard.NoData").Text" text="@Localize("EmptyState.Widget.NoData").Text"></wp-empty-state>
        }
        else
        {
            <div class="chart-container">
                <canvas data-chart="trendLine"></canvas>
                <script type="application/json" class="chart-payload">@Html.Raw(Json.Serialize(new { labels = Model.Select(m => m.Period), created = Model.Select(m => m.Created), resolved = Model.Select(m => m.Resolved) }))</script>
            </div>
        }
    </div>
</div>
