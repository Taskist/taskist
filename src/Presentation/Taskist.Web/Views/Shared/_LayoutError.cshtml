@inject Taskist.Web.Helpers.Appearance.IAppearanceService appearanceService
@{
    var appearance = await appearanceService.ResolveAsync();
}
<!DOCTYPE html>
<html lang="en" data-coreui-theme="@appearance.RenderedTheme" data-app-theme-mode="@appearance.Mode" data-app-accent="@appearance.Accent">
<head>
    <script src="~/js/appearance-boot.js" asp-append-version="true"></script>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] - Taskist</title>
    @await Html.PartialAsync("Sections/_Styles")
</head>
<body>
    <div class="bg-body-tertiary min-vh-100 d-flex flex-row align-items-center">
        <div class="container">
            @RenderBody()
        </div>
    </div>
    <!-- Core JS -->
    <script src="~/js/theme/tabler.min.js"></script>
    <script src="~/js/empty-state.js" asp-append-version="true"></script>
</body>

</html>
