@inject GeneralSettings GeneralSettings
@inject Taskist.Core.Configuration.IAppInfoProvider AppInfo
<footer class="footer mt-3 px-4">
    <div>
        © @DateTime.Today.Year <a href="https://somaraj.com/" target="_blank" class="text-decoration-none">@(string.IsNullOrWhiteSpace(GeneralSettings.CompanyName) ? "Somaraj N" : GeneralSettings.CompanyName)</a>
    </div>
    <div class="ms-auto d-none d-md-flex align-items-center">
        <span class="me-3 text-muted">Version @AppInfo.Version</span>
        @if (AppInfo.IsBeta)
        {
            <span class="app-beta-chip me-3">BETA</span>
        }
        <a href="mailto:@(string.IsNullOrWhiteSpace(GeneralSettings.SupportEmail) ? "taskist@outlook.in" : GeneralSettings.SupportEmail)" class="text-decoration-none">Support</a>
    </div>
</footer>