@model UserListModel
@{
    ViewData["Title"] = Localize("UserPage.Title");
}

@section PageStyles {
    <link href="~/css/pages/user-list.css" rel="stylesheet" asp-append-version="true" />
}

<wp-filter-panel id="empFilter">
        <div class="row g-3 align-items-end emp-filter">
            <div class="col-sm-6 col-lg-4">
                <label class="form-label small text-muted mb-1">@Localize("UserFilterModel.Status")</label>
                <select class="form-control form-control-sm emp-multi" id="empStatusSel" multiple data-placeholder="@Localize("UserFilterModel.Any").Text" asp-items="Model.AvailableStatuses"></select>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label class="form-label small text-muted mb-1">@Localize("UserFilterModel.Role")</label>
                <select class="form-control form-control-sm emp-multi" id="empRoleSel" multiple data-placeholder="@Localize("UserFilterModel.Any").Text" asp-items="Model.AvailableRoles"></select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small text-muted mb-1">@Localize("UserFilterModel.Locked")</label>
                <select class="form-control form-control-sm" id="empLockedSel">
                    <option value="">@Localize("UserFilterModel.Any")</option>
                    <option value="true">@Localize("UserFilterModel.LockedYes")</option>
                    <option value="false">@Localize("UserFilterModel.LockedNo")</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2 justify-content-end ms-auto">
                <button type="button" class="btn btn-sm btn-primary" id="empApply"><i class="fas fa-filter me-1"></i>@Localize("Button.Apply")</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="empReset"><i class="fas fa-rotate-left me-1"></i>@Localize("Button.Reset")</button>
            </div>
        </div>
</wp-filter-panel>

@* Hidden CSV mirrors of the multi-selects — the grid's filter sends these (string), so int[] binds.
   empStatus is seeded with Active (1) so the grid's first load already shows active users. *@
<input type="hidden" id="empStatus" value="1" />
<input type="hidden" id="empRole" />

@await Html.PartialAsync("DataTable", new DataTableModel
{
    Name = "UserGrid",
    Title = Localize("UserPage.Title").Text,
    LengthChangeLabel = Localize("Grid.LengthChangeLabel").Text,
    SearchLabel = Localize("Grid.SearchLabel").Text,
    SearchPlaceholder = Localize("Grid.SearchPlaceholder").Text,
    ZeroRecordsLabel = Localize("Grid.ZeroRecords").Text,
    FooterInfoLabel = Localize("Grid.FooterInfo").Text,
    FooterInfoWhenEmptyLabel = Localize("Grid.FooterInfoWhenEmpty").Text,
    UrlRead = Url.Action("DataRead"),
    FilterParameters = new List<FilterModel>
    {
        new FilterModel { Parameter = "Statuses", Element = "empStatus" },
        new FilterModel { Parameter = "RoleIds", Element = "empRole" },
        new FilterModel { Parameter = "Locked", Element = "empLockedSel" }
    },
    HeaderActions = new List<ActionModel>
    {
        new ActionModel {
            Title = Localize("Button.AddNew").Text,
            Url = Url.Action("Create"),
            Text = Localize("Button.AddNew").Text,
            Icon = "fas fa-plus",
            HyperLinkType = HyperLinkType.BUTTON_TEXT_ICON,
            NavigationType = NavigationType.STANDARD,
            ButtonColor = ButtonColor.PRIMARY
        }
    },
    ColumnActions = new List<ActionModel>
    {
        new ActionModel {
            Title = Localize("Button.Edit").Text,
            Url = Url.Action("Edit"),
            Text = Localize("Button.Edit").Text,
            Icon = "far fa-edit",
            ReferenceParameter = "Id",
            HyperLinkType = HyperLinkType.HYPERLINK_TEXT_ICON,
            NavigationType = NavigationType.STANDARD,
            ButtonColor = ButtonColor.PRIMARY
        },
        new ActionModel {
            Title = Localize("ButtonUser.ResetPassword").Text,
            Url = Url.Action("ResetPassword"),
            Text = Localize("ButtonUser.ResetPassword").Text,
            Icon = "fas fa-key",
            ReferenceParameter = "Id",
            HyperLinkType = HyperLinkType.HYPERLINK_TEXT_ICON,
            NavigationType = NavigationType.OFFCANVAS,
            ButtonColor = ButtonColor.PRIMARY
        },
        new ActionModel {
            Title = Localize("UserUnlock.Unlock").Text,
            Url = Url.Action("Unlock"),
            Text = Localize("UserUnlock.Unlock").Text,
            Icon = "fas fa-unlock",
            ReferenceParameter = "Id",
            HyperLinkType = HyperLinkType.HYPERLINK_TEXT_ICON,
            NavigationType = NavigationType.OFFCANVAS,
            ButtonColor = ButtonColor.PRIMARY,
            VisibleConditions = new List<ActionCoditionModel>
            {
                new ActionCoditionModel { ReferenceParameter = "Locked", Operator = Operator.EQUAL, Value = "true" }
            }
        }
    },
    Columns = new List<ColumnModel>
    {
        new ColumnModel { Title = Localize("UserGrid.FirstName").Text, DataColumn = "FirstName" },
        new ColumnModel { Title = Localize("UserGrid.LastName").Text, DataColumn = "LastName" },
        new ColumnModel { Title = Localize("UserGrid.Email").Text, DataColumn = "Email" },
        new ColumnModel { Title = Localize("UserGrid.MobileNumber").Text, DataColumn = "MobileNumber" },
        new ColumnModel { Title = Localize("UserGrid.Status").Text, DataColumn = "StatusName" },
        new ColumnModel { Title = Localize("UserGrid.Locked").Text, DataColumn = "Locked", Conditions = new List<ColumnConditionModel>{
            new ColumnConditionModel { Value = "true", Operator = Operator.EQUAL, Icon = "fa fa-lock", TextColor = "#e55353" },
            new ColumnConditionModel { Value = "false", Operator = Operator.EQUAL, Icon = "fa fa-lock-open", TextColor = "#2eb85c" }
        }}
    }
})

@section PageScripts {
    <script src="~/js/pages/user-list.js" asp-append-version="true"></script>
}
