@model UserRegistrationModel
@{
    ViewData["Title"] = Localize("UserPage.Title");
}

<div class="card">
    <form asp-action="Edit">
        <div class="card-body p-3">
            @await Html.PartialAsync("_Form", Model)
        </div>
        <div class="card-footer text-end p-3">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>@Localize("Button.Save")</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-ban me-1"></i>@Localize("Button.Cancel")</a>
        </div>
    </form>
</div>

@if (Model.TwoFactorEnabled == true)
{
    <div class="card mt-3" id="userTwoFactor"
         data-reset-url="@Url.Action("ResetTwoFactor")"
         data-user-id="@Model.User.Id"
         data-reset-confirm="@Localize("UserPage.TwoFactor.ResetConfirm").Text">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="fw-semibold"><i class="fas fa-shield-halved me-2"></i>@Localize("Profile.TwoFactor.Title").Text <span class="badge bg-success ms-1">@Localize("Profile.TwoFactor.On").Text</span></div>
                <div class="text-muted small">@Localize("UserPage.TwoFactor.ResetHint").Text</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger js-reset-two-factor"><i class="fas fa-rotate-left me-1"></i>@Localize("UserPage.TwoFactor.Reset").Text</button>
        </div>
    </div>
}

@if (Model.LinkedSignIns.Any())
{
    <div class="card mt-3" id="userSignIns"
         data-remove-url="@Url.Action("RemoveSignIn")"
         data-user-id="@Model.User.Id"
         data-remove-confirm="@Localize("UserPage.SignIns.RemoveConfirm").Text">
        <div class="card-header"><i class="fas fa-right-to-bracket me-2"></i>@Localize("Profile.SignIns.Title").Text</div>
        <div class="card-body">
            <div class="text-muted small mb-2">@Localize("UserPage.SignIns.Intro").Text</div>
            @foreach (var link in Model.LinkedSignIns)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <div>
                        @link.ProviderName
                        @if (!string.IsNullOrEmpty(link.Email))
                        {
                            <span class="text-muted">&middot; @link.Email</span>
                        }
                        <div class="text-muted small">
                            @Localize("Profile.SignIns.LastUsed").Text:
                            @(link.LastUsedOn.HasValue ? link.LastUsedOn.Value.ToLocalTime().ToString("g") : Localize("Profile.SignIns.Never").Text)
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger js-remove-signin" data-id="@link.Id"><i class="fas fa-link-slash me-1"></i>@Localize("Profile.SignIns.Unlink").Text</button>
                </div>
            }
        </div>
    </div>
}

@section PageScripts {
    <script src="~/js/pages/masters/remote-select.js" asp-append-version="true"></script>
    <script src="~/js/pages/user-signins.js" asp-append-version="true"></script>
}