@model BacklogModel
<input type="hidden" asp-for="Id"/>
<div asp-validation-summary="ModelOnly" class="message-error"></div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Title" class="form-wc-label"></wc-label>
            <input asp-for="Title" class="form-control form-control-maxlength" autocomplete="off" maxlength="500"/>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="Description" class="form-wc-label"></wc-label>
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
</div>
<button type="button" class="form-section-toggle" data-bs-toggle="collapse" data-bs-target="#attachSection" aria-expanded="true">
    <i class="fas fa-chevron-down chev"></i><i class="fas fa-paperclip"></i> Attachments
</button>
<div id="attachSection" class="collapse show">
    <div id="thumbnail-zone"></div>
    <div class="row">
        <div class="col-md-12">
            <div id="dropzone-container" class="dropzone">
                <div class="dz-message">
                    Drag and drop files here or click to upload
                </div>
            </div>
        </div>
    </div>
</div>
@await Component.InvokeAsync("CustomFields", new { backLogId = Model.Id, placement = CustomFieldPlacementEnum.MainSection })

@* server values for backlog-form.js (loaded by the parent Create/Edit page) *@
<div id="backlog-form-config" class="d-none"
     data-backlog-id="@Model.Id"
     data-upload-url="@Url.Action("UploadDocument")"
     data-documents-url="@Url.Action("Documents")"></div>