@model IList<BacklogDocumentGridModel>
@functions {
    static string FileExt(BacklogDocumentGridModel d)
    {
        return (d.Extension ?? "").TrimStart('.').ToLowerInvariant();
    }

    static bool IsImage(BacklogDocumentGridModel d)
    {
        return !string.IsNullOrEmpty(d.ContentType) && d.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    static string FileColor(string ext) => ext switch
    {
        "pdf" => "pdf",
        "doc" or "docx" => "doc",
        "xls" or "xlsx" or "csv" => "xls",
        "txt" => "txt",
        _ => "other"
    };

    static string FileIcon(string ext) => ext switch
    {
        "pdf" => "fas fa-file-pdf",
        "doc" or "docx" => "fas fa-file-word",
        "xls" or "xlsx" or "csv" => "fas fa-file-excel",
        "ppt" or "pptx" => "fas fa-file-powerpoint",
        "txt" => "fas fa-file-lines",
        "zip" or "rar" or "7z" => "fas fa-file-zipper",
        _ => "fas fa-file"
    };

    static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "";
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int i = 0;
        while (size >= 1024 && i < units.Length - 1) { size /= 1024; i++; }
        return $"{size:0.#} {units[i]}";
    }
}

@if (Model.Count > 0)
{
    <div class="thumbnail-container">
        @foreach (var doc in Model)
        {
            var ext = FileExt(doc);
            var url = Url.Action("ViewDocument", new { token = doc.Id });
            <div id="file-icon-container-@doc.Id" class="file-tile">
                @if (IsImage(doc))
                {
                    <a href="@url" class="file-tile-link js-img-preview" data-src="@url" data-name="@doc.Name" title="@doc.Name">
                        <img class="file-thumb" src="@url" alt="@doc.Name" loading="lazy" />
                    </a>
                }
                else
                {
                    <a href="@url" target="_blank" class="file-tile-link" title="@doc.Name">
                        <div class="file-icon @FileColor(ext)"><i class="@FileIcon(ext)"></i></div>
                    </a>
                }
                <div class="file-name" title="@doc.Name">@doc.Name</div>
                <div class="file-meta">@FormatSize(doc.FileSize)</div>
                <div class="file-tile-actions">
                    <a class="file-action" href="@url" target="_blank" title="Open"><i class="fas fa-up-right-from-square"></i></a>
                    <span class="file-action file-icon-delete" data-token="@doc.Id" title="Delete"><i class="fas fa-trash"></i></span>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="files-empty">
        <i class="far fa-folder-open"></i>
        <div>No files uploaded yet.</div>
    </div>
}

@* AJAX-injected partial: config + init call into the globally-loaded module *@
<div id="backlog-documents-config" class="d-none" data-delete-url="@Url.Action("DeleteDocument")"></div>
<script>
    if (window.BacklogDocuments) BacklogDocuments.init($('#backlog-documents-config').data());
</script>
