			{
				title: '@Localize("BacklogGrid.Release")',
				name: 'Release',
				data: 'Release',
				sortable: true,
				render: function (data, type, row) {
					if(JSManager.hasValue(data)){
						return `<a href="#" class="release-row-filter" data-release="${row.ReleaseId}">${data}</a>`;
					}
					else{
						return '-';
