@model BacklogGridModel
@inject GeneralSettings GeneralSettings
@{
	ViewData["Title"] = Localize("BacklogPage.Title");

	var pageLength = GeneralSettings.ItemsPerPage > 0 ? GeneralSettings.ItemsPerPage : 10;
	var lengthOptions = new List<int> { 10, 25, 50, 100 };
	if (!lengthOptions.Contains(pageLength))
		lengthOptions.Add(pageLength);
	lengthOptions = lengthOptions.Distinct().OrderBy(x => x).ToList();
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/pages/backlog.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/pages/backlog-task.css" asp-append-version="true" />
}

@section PageScripts {
	<script src="~/js/pages/backlog/backlog-filter-select.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-filter.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-filter-inactive.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-grid-age.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-filter-sections.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-grid-refresh.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-selection-bar.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-branch.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-comments.js" asp-append-version="true"></script>
	<script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
	<script src="~/js/report-column-editor.js" asp-append-version="true"></script>
}

<div id="filter-chips" class="d-flex flex-wrap gap-2 mb-2"></div>

<div class="offcanvas offcanvas-end backlog-filter-offcanvas" tabindex="-1" id="backlogFilterOffcanvas" aria-labelledby="backlogFilterOffcanvasLabel">
	<div class="offcanvas-header filter-panel-header">
		<h5 class="offcanvas-title mb-0" id="backlogFilterOffcanvasLabel"><i class="fas fa-filter me-2"></i>Filters</h5>
		<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body">
		<div id="filter-container"></div>
	</div>
</div>

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<div class="d-flex gap-2 ms-auto" id="gridToolbar">
			<button class="btn btn-secondary btn-sm" type="button" id="btnGridRefresh"
					data-label="@Localize("BacklogGrid.Refresh").Text"
					data-updated-label="@Localize("BacklogGrid.RefreshUpdated").Text"
					title="@Localize("BacklogGrid.Refresh")">
				<i class="fas fa-rotate-right"></i>
			</button>
			<button class="btn btn-primary btn-sm active" type="button" id="groupByParentBtn" title="@Localize("BacklogGrid.GroupByParent")" aria-pressed="true"
					data-label-grouped="@Localize("BacklogGrid.Grouped")" data-label-flat="@Localize("BacklogGrid.Flat")">
				<i class="fas fa-sitemap"></i><span class="visually-hidden gbp-label">@Localize("BacklogGrid.Grouped")</span>
			</button>
			<div class="dropdown">
				<button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="columnToggleBtn" data-bs-toggle="dropdown" title="Columns">
					<i class="fas fa-table-columns"></i><span class="col-count-label ms-1 d-none d-lg-inline">Showing 11/11 Columns</span>
				</button>
				<ul class="dropdown-menu dropdown-menu-sm visible-columns" id="columnToggleMenu">
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="3" data-columnname="TaskType" checked /> @Localize("BacklogGrid.TaskType")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="4" data-columnname="Severity" checked /> @Localize("BacklogGrid.Severity")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="5" data-columnname="Status" checked /> @Localize("BacklogGrid.Status")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="6" data-columnname="Age" data-default-visible="true" checked /> @Localize("BacklogGrid.Age")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="7" data-columnname="Project" checked /> @Localize("BacklogGrid.Project")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="8" data-columnname="Module" checked /> @Localize("BacklogGrid.Module")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="9" data-columnname="SubModule" checked /> @Localize("BacklogGrid.SubModule")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="10" data-columnname="Assignee" checked /> @Localize("BacklogGrid.Assignee")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="11" data-columnname="Tester" checked /> @Localize("BacklogGrid.Tester")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="12" data-columnname="Release" checked /> @Localize("BacklogGrid.Release")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="13" data-columnname="DueDate" checked /> @Localize("BacklogGrid.DueDate")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="14" data-columnname="CreatedBy" checked /> @Localize("BacklogGrid.CreatedBy")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="15" data-columnname="CreatedOn" checked /> @Localize("BacklogGrid.CreatedOn")
						</label>
					</li>
					<li>
						<label class="dropdown-item">
							<input type="checkbox" data-column="16" data-columnname="Reporter" checked /> @Localize("BacklogGrid.Reporter")
						</label>
					</li>
					<li><hr class="dropdown-divider"></li>
					<li><button class="dropdown-item text-danger" id="resetColumn">Show All</button></li>
				</ul>
			</div>
			<div class="btn-group">
				<button id="btnExcelExport" type="button" class="btn btn-success btn-sm text-white" title="@Localize("BacklogGrid.Button.Download")">
					<i class="fa-solid fa-file-excel"></i>
				</button>
				<button type="button" class="btn btn-success btn-sm text-white dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="@Localize("ReportLayout.Button")">
					<span class="visually-hidden">@Localize("ReportLayout.Button")</span>
				</button>
				<ul class="dropdown-menu dropdown-menu-end">
					<li>
						<a class="dropdown-item" href="#"
						   data-report-layout="@ReportExportKey.Backlogs"
						   data-title="@Localize("ReportLayout.Title").Text"
						   data-editor-url="@Url.Action("Editor", "ReportLayout")"
						   data-save-url="@Url.Action("Save", "ReportLayout")"
						   data-reset-url="@Url.Action("Reset", "ReportLayout")"
						   data-save-text="@Localize("ReportLayout.SaveMine").Text"
						   data-reset-text="@Localize("ReportLayout.ResetToDefault").Text"
						   data-cancel-text="@Localize("Button.Cancel").Text">
							<i class="fas fa-table-columns me-2"></i>@Localize("ReportLayout.Button")
						</a>
					</li>
				</ul>
			</div>
			<button type="button" class="btn btn-sm filter-open-btn" data-bs-toggle="offcanvas" data-bs-target="#backlogFilterOffcanvas" title="Filter">
				<i class="fas fa-filter"></i><span class="d-none d-lg-inline ms-1">Filter</span> <span id="filter-counter" class="filter-count-badge"></span>
			</button>
			<a id="btnAddNew" href="@Url.Action("Create")" class="btn btn-sm btn-primary" title="Add New">
				<i class="fas fa-plus"></i><span class="d-none d-lg-inline ms-1">Add New</span>
			</a>
		</div>
	</div>
	<div class="grid-selection-bar d-none" id="gridSelectionBar" role="region" aria-live="polite">
		<span class="grid-selection-count"><i class="fas fa-square-check me-1"></i><span id="gridSelectionCount">0</span> @Localize("BacklogGrid.Selection.Selected")</span>
		<div class="grid-selection-actions">
				<a id="btnBatchUpdate" href="javascript:openBatchUpdate()" class="btn btn-sm grid-selection-btn" title="@Localize("BacklogGrid.Button.BatchUpdate")">
					<i class="fa-regular fa-pen-to-square"></i><span class="ms-1">@Localize("BacklogGrid.Button.BatchUpdate")</span>
				</a>
				@if (Model.CanCreateBranch)
				{
					<button type="button" id="btnBulkCreateBranch" class="btn btn-sm grid-selection-btn"
							data-edit-url="@Url.Action("Edit")"
							data-context-url="@Url.Action("BranchContext")"
							data-create-url="@Url.Action("CreateBranch")"
							data-label-create-title="@Localize("Backlog.Branch.CreateTitle").Text"
							data-label-create="@Localize("Backlog.Branch.Create").Text"
							data-label-name="@Localize("Backlog.Branch.Name").Text"
							data-label-base="@Localize("Backlog.Branch.Base").Text"
							data-label-link-info="@Localize("Backlog.Branch.LinkInfo").Text"
							data-label-name-required="@Localize("Backlog.Branch.NameRequired").Text"
							data-label-disabled="@Localize("Backlog.Branch.Disabled").Text"
							data-connect-url="@Url.Action("Index", "Profile", new { connect = "gitlab" }, null, null, "git")"
							data-connect-label="@Localize("Backlog.Branch.ConnectButton").Text"
							data-label-connect-why="@Localize("Backlog.Branch.ConnectWhy").Text"
							data-label-existing-some="@Localize("Backlog.Branch.ExistingSome").Text"
							data-label-existing-all="@Localize("Backlog.Branch.ExistingAll").Text"
							data-label-include-existing="@Localize("Backlog.Branch.IncludeExisting").Text"
							title="@Localize("Backlog.Branch.Create").Text">
						<i class="fas fa-code-branch"></i><span class="ms-1">@Localize("Backlog.Branch.Create")</span>
					</button>
				}
		</div>
		<button type="button" class="btn btn-sm grid-selection-clear" id="btnClearSelection" title="@Localize("BacklogGrid.Selection.Clear").Text"><i class="fas fa-xmark me-1"></i>@Localize("BacklogGrid.Selection.Clear")</button>
	</div>
	<div class="card-body p-3">
		<table class="table table-bordered table-condensed table-striped nowrap" id="BacklogGrid"></table>
	</div>
</div>

<script>
	let filterLoaded = false;
	let selectedRows = new Set();
	let groupByParent = true;
	let isGroupedView = true;
	let filterMode = parseInt('@Model.FilterMode');
	const filterModeValue = '@(Model.FilterLabel ?? Model.FilterValue)';
	const localStorageFilters = 'backlog-filters-@Model.UserGuid';
	const localStorageVisibleCols = 'backlog-visiblecols-@Model.UserGuid';

	const presetChipLabels = {
		1: '@Localize("BacklogFilter.Preset.MyTasks").Text',
		2: '@Localize("BacklogFilter.Preset.Reopened").Text',
		3: '@Localize("BacklogFilter.Preset.Resolved").Text',
		4: '@Localize("BacklogFilter.Preset.Release").Text',
		6: '@Localize("BacklogFilter.Preset.Overdue").Text'
	};

	function presetChipText() {
		// Release (4) is applied by pre-selecting the Release filter, which renders its own chip.
		if (filterMode === 4) return '';
		var label = presetChipLabels[filterMode];
		if (!label) return '';
		return label;
	}

	const filterChipDefs = [
		{ id: 'ProjectId', label: 'Project' },
		{ id: 'CreatedById', label: 'Created By' },
		{ id: 'ModuleId', label: 'Module' },
		{ id: 'SubModuleId', label: 'Sub-Module' },
		{ id: 'TaskTypeId', label: 'Type' },
		{ id: 'SeverityId', label: 'Priority' },
		{ id: 'ReporterId', label: 'Reporter' },
		{ id: 'AssigneeId', label: 'Developer' },
		{ id: 'TesterId', label: 'Tester' },
		{ id: 'StatusId', label: 'Status' },
		{ id: 'StatusGroupId', label: 'Status Group' },
		{ id: 'ReleaseId', label: 'Release' }
	];

	let table = null;
	let lastGridFilters = null;

	$(document).ready(function () {
		JSManager.setPageTitle('@Localize("BacklogPage.Title").Text');
		let canReport = JSON.parse('@Model.CanReport.ToString().ToLower()');
		let canEdit = JSON.parse('@Model.CanEdit.ToString().ToLower()');

		filterLoaded = true;

		// Load the persisted "group by parent" preference before the grid initializes.
		var gbpPref = JSManager.ajaxGetWithResponse('@Url.Action("GetGroupByParent")', {});
		groupByParent = (gbpPref === true || gbpPref === 'true');
		updateGroupByParentBtn();

		const dto = {
			filterMode : filterMode,
			filterValue: '@Model.FilterValue',
			project: '@Model.FilterProjectId',
			assignee: '@Model.FilterAssigneeId'
		};

		const valueFromLocalStorage = localStorage.getItem(localStorageVisibleCols) ?? '';
		const visibleColsArray = valueFromLocalStorage.split(',');
		$('#columnToggleMenu input[type="checkbox"]').each(function() {
			$(this).prop('checked', BacklogAge.isColumnChecked($(this), visibleColsArray));
		});

		setVisibleColumnCount();

		JSManager.renderPartial('@Url.Action("Filter")', dto, 'filter-container', function () { BacklogFilter.init(); });

		$('#gridToolbar').appendTo('#pageButtons');
		$('#BacklogGrid').closest('.card').children('.card-header').remove();

		BacklogAge.bindTooltips('#BacklogGrid');

		table = $("#BacklogGrid").DataTable({
			processing: true,
			serverSide: true,
			stateSave: true,
			stateLoadParams: function (settings, data) {
				// A preset link (?filter=N) must show exactly its tasks, so drop any search saved from an earlier visit.
				if (filterMode > 0 && data && data.search) data.search.search = '';
			},
			info: true,
			autoWidth: false,
			filter: false,
			lengthChange: true,
			pageLength: @pageLength,
			lengthMenu: [@string.Join(", ", lengthOptions)],
			searching: true,
			ordering: true,
			order: [[1, 'desc']],
			language: {
				search: '<span>@Localize("Grid.SearchLabel").Text</span> _INPUT_',
				searchPlaceholder: '@Localize("Grid.SearchPlaceholder").Text',
				lengthMenu: '_MENU_ @Localize("Grid.LengthChangeLabel").Text',
				paginate: { 'first': 'First', 'last': 'Last', 'next': '&rarr;', 'previous': '&larr;' },
				zeroRecords: '@Localize("Grid.ZeroRecords").Text',
				info: '@Localize("Grid.FooterInfo").Text',
				infoEmpty: '@Localize("Grid.FooterInfoWhenEmpty").Text'
			},
			ajax: {
				url: "@Url.Action("DataRead")",
				type: "POST",
				datatype: "json",
				data: function (dto) {
					// A manual/auto refresh reuses the filters of the last load, so unsaved
					// edits in the filter panel are never applied without pressing Search.
					const filters = (BacklogRefresh.consume() && lastGridFilters) ? lastGridFilters : setFilterParam({});
					lastGridFilters = filters;
					$.extend(dto, filters);
					dto.groupByParent = groupByParent;
					isGroupedView = groupByParent && !dtoHasActiveFilter(dto);
					JSManager.addAntiForgeryToken(dto);
				}
			},
			columns: [{
				data: "Id",
				title: '<input type="checkbox" id="row-checkbox-select-all" />',
				sortable: false,
				render: function(data, type, row) {
					return `<input type="checkbox" class="row-checkbox" value="${data}" ${selectedRows.has(data) ? "checked" : ""}>`;
				},
				orderable: false
			},{
				title: '@Localize("BacklogGrid.TaskId")',
				data: 'Id',
				name: 'Id',
				sortable: true,
				render: function (data, type, row) {
					let html = `<a title = "@Localize("Button.Edit")" href="@Url.Action("Edit")/${row.Id}">${row.Id}</a>`
					return data;
				}
			},{
				title: '@Localize("BacklogGrid.Title")',
				data: 'Title',
				sortable: true,
				render: function (data, type, row) {
					let html = '';
					let htmlAttachmentAndComment = '';
					let reopenCounterClass = '';

					let titleIcons = [];
					const iconCount = n => n > 1 ? `<span class="dt-title-icon__count">${n}</span>` : '';

					if (row.BranchNames && row.BranchNames.length) {
						titleIcons.push(`<a href="@Url.Action("Edit")/${row.Id}#taskCodeCard" class="dt-title-icon dt-title-icon--branch" title="@Localize("BacklogGrid.Icon.Branch").Text: ${stEsc(row.BranchNames.join(', '))}"><i class="fas fa-code-branch"></i>${iconCount(row.BranchNames.length)}</a>`);
					}

					if (row.HasClosingComment) {
						titleIcons.push(`<a href="javascript:JSManager.openForm('@Url.Action("ViewClosingComment")/${row.Id}','@Localize("BacklogGrid.Icon.ClosingDetails").Text','col-md-6',undefined,false)" class="dt-title-icon dt-title-icon--closing" title="@Localize("BacklogGrid.Icon.ClosingDetails").Text${row.MrId > 0 ? ' · MR !' + row.MrId : ''}"><i class="fas fa-code-merge"></i></a>`);
					}

					if (row.AttachmentCount > 0) {
						titleIcons.push(`<a href="javascript:JSManager.openOffCanvas('@Url.Action("Documents")/${row.Id}','Documents')" class="dt-title-icon dt-title-icon--files" title="${row.AttachmentCount} @Localize("BacklogGrid.Icon.Attachments").Text"><i class="fas fa-paperclip"></i>${iconCount(row.AttachmentCount)}</a>`);
					}

					if (row.CommentCount > 0) {
						titleIcons.push(`<a href="javascript:JSManager.openOffCanvas('@Url.Action("Comments")/${row.Id}','Comments')" class="dt-title-icon dt-title-icon--comments" title="${row.CommentCount} @Localize("BacklogGrid.Icon.Comments").Text"><i class="far fa-comment-dots"></i>${iconCount(row.CommentCount)}</a>`);
					}

					htmlAttachmentAndComment = titleIcons.length ? `<span class="dt-title-icons">${titleIcons.join('')}</span>` : '';

					if (parseInt(row.ReOpenCount) > 2) {
						reopenCounterClass = 'bg-danger';
					}else if (parseInt(row.ReOpenCount) > 0) {
						reopenCounterClass = 'bg-warning';
					}

					if(data.length > 50) {
						let truncatedText = data.substr(0, 50) + "...";
						html = `<a title = "@Localize("Button.Edit")" href="@Url.Action("Edit")/${row.Id}"><span class="dt-truncate"
								 tabindex="0"
								 role="button"
								 data-bs-toggle="popover"
								 data-bs-trigger="hover focus"
								 data-bs-content="${data}">
								${truncatedText}
							</span></a>${htmlAttachmentAndComment}`;
					}else {
						html = `<a title = "@Localize("Button.Edit")" href="@Url.Action("Edit")/${row.Id}">${data}</a>${htmlAttachmentAndComment}`;
					}

					if(parseInt(row.ReOpenCount) > 0) {
						html = `<div class="position-relative badge-counter" title="Reopened count">${html}
						<span class="position-absolute top-0 start-0 translate-middle badge rounded-pill ${reopenCounterClass}">
						${row.ReOpenCount}
						<span class="visually-hidden">unread messages</span>
						</span>
						</div>`;
					}

					if (isGroupedView && parseInt(row.SubTaskCount) > 0) {
						html = `<span class="subtask-toggle" role="button" title="${row.SubTaskCount} sub-task(s)"><i class="fas fa-caret-right"></i></span>` + html;
					}

					return html;
				}
			},
			{
				title: '@Localize("BacklogGrid.TaskType")',
				data: 'TaskType.Name',
				name: 'TaskType.Name',
				sortable: true,
				render: function (data, type, row) {
					return `<a href="#" class="tasktype-row-filter" data-tasktype="${row.TaskType.Id}">
							<span class="badge" style="color:${row.TaskType.TextColor};background-color:${row.TaskType.BackgroundColor};"><i class="${row.TaskType.IconClass} me-1"></i>${row.TaskType.Name}</span>
							</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.Severity")',
				data: 'Severity.Name',
				name: 'Severity.Name',
				sortable: true,
				render: function (data, type, row) {
					return `<a href="#" class="severity-row-filter" data-severity="${row.Severity.Id}">
							<span class="badge" style="color:${row.Severity.TextColor};background-color:${row.Severity.BackgroundColor};"><i class="${row.Severity.IconClass} me-1"></i>${row.Severity.Name}</span>
							</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.Status")',
				sortable: true,
				data: 'Status.Name',
				name: 'Status.Name',
				render: function (data, type, row) {
					let statusTitle = `C: ${row.CreatedBy} on ${moment(row.CreatedOn).format('DD-MMM-YYYY HH:MM:SS')}`;
					if(JSManager.hasValue(row.ModifiedBy)){
						statusTitle = `M: ${row.ModifiedBy} on ${moment(row.ModifiedOn).format('DD-MMM-YYYY HH:MM:SS')}`;
					}
					return `<a href="#" title="${statusTitle}" class="status-row-filter" data-status="${row.Status.Id}">
							<span class="badge" style="color:${row.Status.TextColor};background-color:${row.Status.BackgroundColor};"><i class="${row.Status.IconClass} me-1"></i>${row.Status.Name}</span>
							</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.Age") <i class="far fa-circle-question backlog-age-help" data-bs-toggle="tooltip" data-bs-html="true" data-bs-title="@Localize("BacklogGrid.AgeHelp").Text"></i>',
				data: 'AgeDays',
				name: 'Age',
				sortable: true,
				orderSequence: ['desc', 'asc'],
				render: function (data, type, row) {
					return BacklogAge.render(row);
				}
			},
			{
				title: '@Localize("BacklogGrid.Project")',
				name: 'Project',
				data: 'Project',
				sortable: true,
				render: function (data, type, row) {
					return `<a href="#" class="project-row-filter" data-project="${row.ProjectId}">${data}</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.Module")',
				name: 'Module',
				data: 'Module',
				sortable: true,
				render: function (data, type, row) {
					return `<a href="#" class="module-row-filter" data-module="${row.ModuleId}">${data}</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.SubModule")',
				name: 'SubModule',
				data: 'SubModule',
				sortable: true,
				render: function (data, type, row) {
					return `<a href="#" class="submodule-row-filter" data-submodule="${row.SubModuleId}">${data}</a>`;
				}
			},
			{
				title: '@Localize("BacklogGrid.Assignee")',
				name: 'Assignee',
				data: 'Assignee',
				sortable: true,
				render: function (data, type, row) {
					if(JSManager.hasValue(data)){
						return `<a href="#" class="assignee-row-filter" data-assignee="${row.AssigneeId}">${data}</a>`;
					}
					else{
						return '-'
					}
				}
			},
			{
				title: '@Localize("BacklogGrid.Tester")',
				name: 'Tester',
				data: 'Tester',
				sortable: true,
