	function dtoHasActiveFilter(dto) {
		var arrays = ['createdby','module','subModule','taskType','severity','reporter','assignee','tester',
			'status','statusGroup','release','project','statusDays','openDays'];
		for (var i = 0; i < arrays.length; i++) {
			var v = dto[arrays[i]];
			if (Array.isArray(v) ? v.length > 0 : (v != null && v !== '')) return true;
		}
		if (dto.dueDate) return true;
		if (parseInt(dto.filterMode) > 0) return true;
		if (dto.search && dto.search.value && dto.search.value.trim() !== '') return true;
		return false;
	}

	function updateGroupByParentBtn() {
		var btn = $('#groupByParentBtn');
		btn.attr('aria-pressed', groupByParent ? 'true' : 'false');
		btn.toggleClass('active btn-primary', groupByParent);
		btn.toggleClass('btn-secondary', !groupByParent);
		btn.find('.gbp-label').text(groupByParent ? btn.data('label-grouped') : btn.data('label-flat'));
		btn.attr('title', groupByParent ? btn.data('label-grouped') : btn.data('label-flat'));
		btn.find('i').toggleClass('fa-sitemap', groupByParent).toggleClass('fa-list', !groupByParent);
	}

	function stEsc(s) {
		return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	function stInitials(name) {
		if (!name) return '?';
		var parts = name.trim().split(/\s+/);
		return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
	}

	function stAvatarColor(name) {
		var palette = ['#0ea5e9', '#8b5cf6', '#22c55e', '#f59e0b', '#ef4444', '#14b8a6', '#ec4899', '#6366f1'];
		var h = 0;
		for (var i = 0; i < (name || '').length; i++) h = (h * 31 + name.charCodeAt(i)) % palette.length;
		return palette[h];
	}

	function stDue(dateStr) {
		if (!dateStr) return '';
		var d = moment(dateStr), today = moment().startOf('day');
		var diff = d.startOf('day').diff(today, 'days');
		var cls = diff < 0 ? 'subtask-due--over' : (diff === 0 ? 'subtask-due--today' : 'subtask-due--future');
		return '<span class="subtask-due ' + cls + '"><i class="far fa-clock me-1"></i>' + d.format('DD-MMM') + '</span>';
	}

	function stRow(c) {
		var caret = parseInt(c.SubTaskCount) > 0
			? '<span class="subtask-caret" role="button" data-id="' + c.Id + '" title="' + c.SubTaskCount + ' sub-task(s)"><i class="fas fa-caret-right"></i></span>'
			: '<span class="subtask-caret subtask-caret--leaf"></span>';

		var typeChip = '<span class="subtask-type-chip" style="background:' + stEsc(c.TaskTypeColor || '#64748b') + '" title="' + stEsc(c.TaskTypeName) + '">' +
			(c.TaskTypeIcon ? '<i class="' + stEsc(c.TaskTypeIcon) + '"></i>' : stEsc((c.TaskTypeName || '?').substr(0, 2))) + '</span>';

		var pill = c.StatusName
			? '<span class="subtask-status" style="background:' + stEsc(c.StatusColor || '#94a3b8') + '">' + stEsc(c.StatusName) + '</span>'
			: '';

		var avatar = c.AssigneeName
			? '<span class="subtask-avatar" style="background:' + stAvatarColor(c.AssigneeName) + '" title="' + stEsc(c.AssigneeName) + '">' + stEsc(stInitials(c.AssigneeName)) + '</span>'
			: '';

		return '<div class="subtask-row" data-id="' + c.Id + '">' +
				'<div class="subtask-main">' +
					caret + typeChip +
					'<a class="subtask-title" href="@Url.Action("Edit")/' + c.Id + '" title="' + stEsc(c.Title) + '">' +
						'<span class="subtask-id">#' + c.Id + '</span> ' + stEsc(c.Title) + '</a>' +
				'</div>' +
				'<div class="subtask-meta">' + pill + stDue(c.DueDate) + avatar + '</div>' +
				'<div class="subtask-nested" data-loaded="0"></div>' +
			'</div>';
	}

	function renderSubtaskChildren(children) {
		if (!children || !children.length) {
			return '<div class="subtask-panel"><span class="subtask-empty">No sub-tasks.</span></div>';
		}
		return '<div class="subtask-panel">' + children.map(stRow).join('') + '</div>';
	}

