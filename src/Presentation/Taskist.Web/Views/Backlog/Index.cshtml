				}
			},
			{
				title: '@Localize("BacklogGrid.DueDate")',
				name: 'DueDate',
				data: 'DueDate',
				sortable: true,
				render: function (data, type, row) {
					if (!JSManager.hasValue(data))
						return 'Not set';

					const formatted = moment(data).format('DD-MMM-YYYY');

					if (row.Status.GroupId === 5)
						return `<i class="far fa-calendar-check text-success me-1"></i>${formatted}`;

					const dayDifference = moment(data).diff(moment(), "days");
					if (dayDifference < 0)
						return `<i class="far fa-calendar-times text-danger me-1" title="Overdue by ${Math.abs(dayDifference)} days"></i>${formatted}`;
					else if (dayDifference === 0)
						return `<i class="far fa-calendar-check text-success me-1" title="Due today!"></i>${formatted}`;
					else
						return `<i class="far fa-calendar-plus text-primary me-1" title="${dayDifference} days remaining"></i>${formatted}`;
				}
			},
			{
				title: '@Localize("BacklogGrid.CreatedBy")',
				name: 'CreatedBy',
				data: 'CreatedBy',
				sortable: true,
				render: function (data, type, row) {
