		$('#BacklogGrid tbody').on('click', '.subtask-toggle', function (e) {
			e.preventDefault();
			e.stopPropagation();
			var $toggle = $(this);
			var tr = $toggle.closest('tr');
			var row = table.row(tr);
			if (!row || !row.data()) return;

			if (row.child.isShown()) {
				row.child.hide();
				tr.removeClass('subtask-open');
				$toggle.find('i').removeClass('fa-caret-down').addClass('fa-caret-right');
				return;
			}

			var rowData = row.data();
			if (rowData._children) {
				row.child(rowData._children).show();
				tr.addClass('subtask-open');
				$toggle.find('i').removeClass('fa-caret-right').addClass('fa-caret-down');
				return;
			}

			$toggle.find('i').removeClass('fa-caret-right').addClass('fa-spinner fa-spin');
			$.getJSON('@Url.Action("Children")/' + rowData.Id, function (children) {
				var html = renderSubtaskChildren(children);
				rowData._children = html;
				row.child(html).show();
				tr.addClass('subtask-open');
				$toggle.find('i').removeClass('fa-spinner fa-spin').addClass('fa-caret-down');
			}).fail(function () {
				$toggle.find('i').removeClass('fa-spinner fa-spin').addClass('fa-caret-right');
				if (window.toastr) toastr.error('Could not load sub-tasks.');
			});
		});

		// Recursive drill-down: a nested child that itself has sub-tasks.
		$('#BacklogGrid tbody').on('click', '.subtask-caret[data-id]', function (e) {
			e.preventDefault();
			e.stopPropagation();
			var $caret = $(this);
			var childId = $caret.data('id');
			var $rowEl = $caret.closest('.subtask-row');
			var $nested = $rowEl.children('.subtask-nested');

			if ($rowEl.hasClass('open')) {
				$rowEl.removeClass('open');
				$nested.slideUp(120);
				$caret.find('i').removeClass('fa-caret-down').addClass('fa-caret-right');
				return;
			}

			if ($nested.attr('data-loaded') === '1') {
				$rowEl.addClass('open');
				$nested.slideDown(120);
				$caret.find('i').removeClass('fa-caret-right').addClass('fa-caret-down');
				return;
			}

			$caret.find('i').removeClass('fa-caret-right').addClass('fa-spinner fa-spin');
			$.getJSON('@Url.Action("Children")/' + childId, function (children) {
				$nested.html(renderSubtaskChildren(children)).attr('data-loaded', '1');
				$rowEl.addClass('open');
				$nested.hide().slideDown(120);
				$caret.find('i').removeClass('fa-spinner fa-spin').addClass('fa-caret-down');
			}).fail(function () {
				$caret.find('i').removeClass('fa-spinner fa-spin').addClass('fa-caret-right');
				if (window.toastr) toastr.error('Could not load sub-tasks.');
			});
		});

