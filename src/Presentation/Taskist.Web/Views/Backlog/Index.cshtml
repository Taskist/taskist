		dto.taskType = $('#TaskTypeId').val();
		dto.severity = $('#SeverityId').val();
		dto.reporter = $('#ReporterId').val();
		dto.assignee = $('#AssigneeId').val();
		dto.tester = $('#TesterId').val();
		dto.status = $('#StatusId').val();
		dto.statusGroup = $('#StatusGroupId').val();
		dto.release = $('#ReleaseId').val();
		dto.project = $('#ProjectId').val();
		dto.dueDateType = $('#DueDateType').val();
		dto.dueDate = $('#DueDate').val();
		dto.statusDays = $('#StatusDaysMin').val() || null;
		dto.openDays = $('#OpenDaysMin').val() || null;
		dto.filterMode = filterMode;
		return dto;
	}

	function clearPreset() {
		filterMode = 0;
		try {
			const url = new URL(window.location.href);
			if (url.searchParams.has('filter') || url.searchParams.has('filterValue')) {
				url.searchParams.delete('filter');
				url.searchParams.delete('filterValue');
				window.history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
			}
		} catch (e) { }
	}

	function renderFilterChips() {
		const $c = $('#filter-chips').empty();

		const presetText = presetChipText();
		if (presetText) {
			$c.append(`<span class="filter-chip">
				<span class="filter-chip-label">${presetText}</span>
				<button type="button" class="filter-chip-remove" data-target="__preset" title="Remove"><i class="fas fa-times"></i></button></span>`);
		}

		filterChipDefs.forEach(function (d) {
			if (!BacklogFilterSelect.isReady(d.id)) return;
			const items = BacklogFilterSelect.selectedTexts(d.id);
			if (items.length) {
				const text = $('<div>').text(items.join(', ')).html();
				$c.append(`<span class="filter-chip">
					<span class="filter-chip-label">${d.label}:</span>${text}
					<button type="button" class="filter-chip-remove" data-target="${d.id}" title="Remove"><i class="fas fa-times"></i></button></span>`);
			}
		});

		const due = $('#DueDate').val();
		if (JSManager.hasValue(due)) {
			const type = $('#DueDateType option:selected').text();
			$c.append(`<span class="filter-chip">
				<span class="filter-chip-label">${type}:</span>${due}
				<button type="button" class="filter-chip-remove" data-target="DueDate" title="Remove"><i class="fas fa-times"></i></button></span>`);
		}

		[{ id: 'StatusDaysMin', label: 'In status ≥' }, { id: 'OpenDaysMin', label: 'Open ≥' }].forEach(function (d) {
			const days = parseInt($('#' + d.id).val(), 10);
			if (days > 0) {
				$c.append(`<span class="filter-chip">
					<span class="filter-chip-label">${d.label}</span> ${days} days
					<button type="button" class="filter-chip-remove" data-target="${d.id}" title="Remove"><i class="fas fa-times"></i></button></span>`);
			}
		});
	}

	function saveFilters() {
		localStorage.setItem(localStorageFilters, JSON.stringify(getFilterParam()));
	}

	function loadFilters() {
		const filters = JSON.parse(localStorage.getItem(localStorageFilters) || '{}');

		BacklogInactiveUsers.ensureFor({ AssigneeId: filters.assignee, TesterId: filters.tester, CreatedById: filters.createdby });

		if (filters.createdby) BacklogFilterSelect.set("CreatedById", filters.createdby);
		if (filters.module) BacklogFilterSelect.set("ModuleId", filters.module);
		if (filters.subModule) BacklogFilterSelect.set("SubModuleId", filters.subModule);
		if (filters.taskType) BacklogFilterSelect.set("TaskTypeId", filters.taskType);
		if (filters.severity) BacklogFilterSelect.set("SeverityId", filters.severity);
		if (filters.reporter) BacklogFilterSelect.set("ReporterId", filters.reporter);
		if (filters.assignee) BacklogFilterSelect.set("AssigneeId", filters.assignee);
		if (filters.tester) BacklogFilterSelect.set("TesterId", filters.tester);
		if (filters.status) BacklogFilterSelect.set("StatusId", filters.status);
		if (filters.statusGroup) BacklogFilterSelect.set("StatusGroupId", filters.statusGroup);
		if (filters.release) BacklogFilterSelect.set("ReleaseId", filters.release);
		if (filters.project) BacklogFilterSelect.set("ProjectId", filters.project);
		if (filters.dueDateType) $("#DueDateType").val(filters.dueDateType);
		if (filters.dueDate) $("#DueDate").val(filters.dueDate);
		if (filters.statusDays) $("#StatusDaysMin").val(filters.statusDays);
		if (filters.openDays) $("#OpenDaysMin").val(filters.openDays);
	}

	function deleteFilter(){
		 localStorage.removeItem(localStorageFilters);
		 localStorage.setItem(localStorageFilters, '{}');
		 table.search('').draw();
	}

	function setDefaultFilters(){
		const filters = JSON.parse(localStorage.getItem(localStorageFilters) || '{}');
		if(filterMode === 0 && filters.statusGroup === undefined){
			if(BacklogFilterSelect.isReady("StatusGroupId")){
				BacklogFilterSelect.set("StatusGroupId", ['1','2']);
				$('#btnSearch').trigger('click');
				$("#StatusGroupId").trigger('change');
			}
		}
	}

	function setVisibleColumnCount(){
		let selectedCount = $('#columnToggleMenu input[type="checkbox"]:checked').length;
		const totalColums = $('.visible-columns li>label').length;
		const colToggleBtn = $('#columnToggleBtn');
		colToggleBtn.find('.col-count-label').text(`Showing ${selectedCount}/${totalColums} Columns`);

		if(selectedCount != totalColums){
			colToggleBtn.removeClass('btn-secondary').addClass('btn-warning');
		}else{
			colToggleBtn.removeClass('btn-warning').addClass('btn-secondary');
		}
	}
</script>