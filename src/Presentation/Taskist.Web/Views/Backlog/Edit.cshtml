@model BacklogModel
@{
	ViewData["Title"] = Localize("BacklogPage.Title");
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/pages/backlog/backlog.css" asp-append-version="true" />
}

@section PageScripts {
	<script src="~/js/pages/backlog/backlog-form.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-form-status.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-edit.js" asp-append-version="true"></script>
}

@if (!Model.CanEdit)
{
	<div class="alert alert-danger">You are not authorized to edit this task, please contact IT Support.</div>
}

@* task meta header: id, creator, age *@
<div class="task-meta-header">
	<div class="task-meta-id">#@Model.Id</div>
	<div class="task-meta-info">
		<img class="task-meta-avatar" src="@Url.Action("GetAvatar", "Profile", new { userId = Model.CreatedById })" alt="@Model.CreatedByName" />
		<span class="task-meta-by">@Model.CreatedByName</span>
		<span class="task-meta-sep">&middot;</span>
		<span class="task-meta-age" data-time="@Model.CreatedOn.ToString("o")" title="@Model.CreatedOn.ToString("dd-MMM-yyyy HH:mm")"></span>
	</div>
	<button type="button" class="task-meta-copy" title="Copy link to this task" onclick="copyTaskLink()">
		<i class="fas fa-link"></i>
	</button>
</div>

@* status journey ribbon *@
@if (Model.StatusJourney.Any())
{
	<div class="status-journey">
		@foreach (var leg in Model.StatusJourney)
		{
			<div class="journey-leg @(leg.IsCurrent ? "journey-current" : "")">
				<span class="journey-pill" style="color:@leg.TextColor;background:@leg.BackgroundColor;">
					<i class="@leg.IconClass me-1"></i>@leg.StatusName
				</span>
				<span class="journey-days">@(leg.Days == 0 ? "<1d" : $"{leg.Days}d")</span>
			</div>
		}
	</div>
}

<form asp-action="Edit" enctype="multipart/form-data" id="EditForm">
	@Html.AntiForgeryToken()
	<div class="row">
		<div class="col-md-8">
			<div class="card">
				<div class="card-body p-3">
					@await Html.PartialAsync("_Form", Model)
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card">
				<div class="card-body p-3">
					@await Html.PartialAsync("_FormStatus", Model)
				</div>
			</div>
		</div>
	</div>

	@* floating action pill (bottom-right) *@
	<div class="backlog-fab">
		@if (Model.CanEdit)
		{
			<button type="submit" class="btn btn-sm btn-primary" id="btnSaveBacklog">
				<i class="fas fa-save me-1"></i>@Localize("Button.Save")
			</button>
		}
		@if (Model.CanDelete)
		{
			<button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@Model.Id)">
				<i class="fas fa-trash me-1"></i>@Localize("Button.Delete")
			</button>
		}
		<a asp-action="Index" class="btn btn-sm btn-secondary">
			<i class="fas fa-ban me-1"></i>@Localize("Button.Cancel")
		</a>
	</div>
</form>

@* server values for backlog-edit.js *@
<div id="backlog-edit-config" class="d-none"
	 data-backlog-id="@Model.Id"
	 data-index-url="@Url.Action("Index")"
	 data-delete-url="@Url.Action("DeleteBacklog", "Backlog")"
	 data-history-url="@Url.Action("History", new { Id = Model.Id })"
	 data-comments-url="@Url.Action("Comments", new { Id = Model.Id })"
	 data-labels='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
		pageTitle = Localize("BacklogPage.Title").Text,
		back = Localize("Button.Back").Text,
		historyLabel = Localize("BacklogPage.Button.History").Text,
		commentsLabel = Localize("BacklogPage.Button.Comments").Text
	}))'></div>
