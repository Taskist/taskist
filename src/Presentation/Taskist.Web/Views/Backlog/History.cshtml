@model IList<BacklogCommentGridModel>

@if (Model.Any())
{
    <div class="history-timeline" data-history-ready="false">
        @foreach (var item in Model)
        {
            <div class="history-item">
                <div class="history-dot"><img src="@Url.Action("Photo", "Profile", new { userId = item.CommentById })" alt="@item.CommentBy" /></div>
                <div class="history-content">
                    <div class="history-meta">
                        <span class="history-author">@item.CommentBy</span>
                        <span class="history-time" data-time="@DateTime.SpecifyKind(item.CommentOn, DateTimeKind.Utc).ToString("o")"></span>
                    </div>
                    @if (item.IsTextChange)
                    {
                        <div class="history-text history-change" data-old="@item.OldValue" data-new="@item.NewValue">
                            <div class="history-change-head">
                                <strong>@item.FieldLabel</strong>
                                <span class="history-change-action history-change-action--@item.ChangeAction">@item.ChangeAction</span>
                                <a href="#" class="history-change-toggle">View changes</a>
                            </div>
                            <div class="history-change-body d-none">
                                <div class="btn-group btn-group-sm mb-2" role="group">
                                    <button type="button" class="btn btn-outline-secondary active" data-view="diff">Changes</button>
                                    <button type="button" class="btn btn-outline-secondary" data-view="old">Before</button>
                                    <button type="button" class="btn btn-outline-secondary" data-view="new">After</button>
                                </div>
                                <div class="history-change-view"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="history-text history-collapsible" data-html="@item.Comment"></div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="files-empty">
        <i class="far fa-clock"></i>
        <div>No history yet.</div>
    </div>
}
