@model BacklogModel
@{
	ViewData["Title"] = Localize("BacklogPage.Title");
}

@section PageStyles {
	<link href="~/lib/ion.rangeslider/css/ion.rangeslider.min.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/lib/ladda/ladda-themeless.min.css" />
	<link rel="stylesheet" href="~/css/pages/backlog-task.css" asp-append-version="true" />
}

@section PageScripts {
	<script src="~/lib/ion.rangeslider/js/ion.rangeslider.min.js"></script>
	<script src="~/lib/ladda/spin.min.js"></script>
	<script src="~/lib/ladda/ladda.min.js"></script>
	<script src="~/js/pages/backlog/backlog-form.js" asp-append-version="true"></script>
	<script src="~/js/pages/backlog/backlog-rootcause.js" asp-append-version="true"></script>
}

<form asp-action="Create" id="FormBacklog" class="no-auto-ladda">
	<div class="row">
		<div class="col-md-8">
			<div class="card">
				<div class="card-body p-3">
					<input type="hidden" asp-for="Token" />
					@await Html.PartialAsync("_Form", Model)
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card">
				<div class="card-body p-3">
					@await Html.PartialAsync("_FormStatus", Model)
				</div>
			</div>
		</div>
	</div>
	<div class="backlog-fab-spacer" aria-hidden="true"></div>
	<div class="backlog-fab">
		<span class="backlog-fab-hint" title="@(Localize("Button.Save").Text) (Ctrl+S)"><kbd>Ctrl</kbd>+<kbd>S</kbd></span>
		<button type="submit" class="btn btn-primary btn-sm ladda-button" data-style="expand-right" title="@(Localize("Button.Save").Text) (Ctrl+S)">
			<span class="ladda-label">
				<i class="fas fa-save me-1"></i>@Localize("Button.Save")
			</span>
		</button>
		@if (Model.Id <= 0)
		{
			<button type="submit" name="save-continue" class="btn btn-primary btn-sm ladda-button" data-style="expand-right">
				<i class="fas fa-save me-1"></i>@Localize("Button.SaveAndContinue")
			</button>
		}
		<a asp-action="Index" class="btn btn-sm btn-secondary">
			<i class="fas fa-ban me-1"></i>@Localize("Button.Cancel")
		</a>
	</div>
</form>