@model BacklogModel
@{
    var updateCssClassName = "";
    var updateCssClassNameModule = "";
    if (Model.Id > 0 && Model.CanEdit)
    {
        updateCssClassName = "ajax-update";
        updateCssClassNameModule = "ajax-update-module";
    }
}
<input type="hidden" asp-for="Id" />
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ProjectId" />
            <select asp-for="ProjectId" asp-items="Model.AvailableProjects" class="form-control select2 backlog-project" disabled="@(!Model.CanEditProject)"></select>
            <span asp-validation-for="ProjectId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="StatusId" />
            <select class="form-control select2 @updateCssClassName" asp-for="StatusId" asp-items="Model.AvailableStatus"></select>
            <span asp-validation-for="StatusId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="mb-3">
            <wc-label asp-for="ModuleId" />
            <select class="form-control select2 @updateCssClassNameModule" asp-for="ModuleId" asp-items="Model.AvailableModules"></select>
            <span asp-validation-for="ModuleId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="mb-3">
            <wc-label asp-for="SubModuleId" />
            <select class="form-control select2 @updateCssClassNameModule" asp-for="SubModuleId" asp-items="Model.AvailableSubModules"></select>
            <span asp-validation-for="SubModuleId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="TaskTypeId" />
            <select class="form-control select2 @updateCssClassName" asp-for="TaskTypeId" asp-items="Model.AvailableTaskTypes"></select>
            <span asp-validation-for="TaskTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="SeverityId" />
            <select class="form-control select2 @updateCssClassName" asp-for="SeverityId" asp-items="Model.AvailableSeverities"></select>
            <span asp-validation-for="SeverityId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ReporterId" />
            <select class="form-control select2 @updateCssClassName" asp-for="ReporterId" asp-items="Model.AvailableReporters"></select>
            <span asp-validation-for="ReporterId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="mb-3">
            <wc-label asp-for="AssigneeId" />
            <select class="form-control select2 @updateCssClassName" asp-for="AssigneeId" asp-items="Model.AvailableAssignees"></select>
            <span asp-validation-for="AssigneeId" class="text-danger"></span>
            <div class="wp-avail" data-avail-for="AssigneeId"></div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="mb-3">
            <wc-label asp-for="TesterId" />
            <select class="form-control select2 @updateCssClassName" asp-for="TesterId" asp-items="Model.AvailableTesters"></select>
            <span asp-validation-for="TesterId" class="text-danger"></span>
            <div class="wp-avail" data-avail-for="TesterId"></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="PlannedStartDate" />
            <input asp-for="PlannedStartDate" class="form-control datepicker @updateCssClassName" autocomplete="off" type="text" maxlength="15" />
            <span asp-validation-for="PlannedStartDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="DueDate" />
            <input asp-for="DueDate" class="form-control datepicker @updateCssClassName" autocomplete="off" type="text" maxlength="15" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ReleaseId" />
            <select class="form-control select2 @updateCssClassName" asp-for="ReleaseId" asp-items="Model.AvailableReleases"></select>
            <span asp-validation-for="ReleaseId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="closing-checklist @(Model.Id > 0 && Model.ShowRootCauseTab ? "" : "d-none")" id="closingChecklist">
    <div class="closing-checklist__head">
        <i class="fas fa-list-check me-1"></i>@Localize("BacklogPage.ClosingChecklist.Title")
        <span class="closing-checklist__for" id="closingChecklistFor"></span>
    </div>
    <div class="closing-checklist__items">
        <button type="button" class="closing-chip" data-item="rc" data-goto="rca">
            <i class="closing-chip__icon"></i><span>@Localize("BacklogPage.RootCauseFix.RootCause")</span>
        </button>
        <button type="button" class="closing-chip" data-item="res" data-goto="rca">
            <i class="closing-chip__icon"></i><span>@Localize("BacklogPage.RootCauseFix.Resolution")</span>
        </button>
        <button type="button" class="closing-chip" data-item="mr" data-goto="code">
            <i class="closing-chip__icon"></i><span>@Localize("BacklogPage.ClosingChecklist.Mr")</span>
        </button>
    </div>
</div>


@await Component.InvokeAsync("CustomFields", new { backLogId = Model.Id, placement = CustomFieldPlacement.StatusSection, projectId = Model.ProjectId })
