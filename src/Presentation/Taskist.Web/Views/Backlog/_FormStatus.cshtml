@model BacklogModel
<input type="hidden" asp-for="Id" />
<div class="row">
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ProjectId" />
            <select class="form-control select2" asp-for="ProjectId" asp-items="Model.AvailableProjects"></select>
            <span asp-validation-for="ProjectId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ModuleId" />
            <select class="form-control select2" asp-for="ModuleId" asp-items="Model.AvailableModules"></select>
            <span asp-validation-for="ModuleId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="SubModuleId" />
            <select class="form-control select2" asp-for="SubModuleId" asp-items="Model.AvailableSubModules"></select>
            <span asp-validation-for="SubModuleId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="TaskTypeId" />
            <select class="form-control select2" asp-for="TaskTypeId" asp-items="Model.AvailableTaskTypes"></select>
            <span asp-validation-for="TaskTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="SeverityId" />
            <select class="form-control select2" asp-for="SeverityId" asp-items="Model.AvailableSeverities"></select>
            <span asp-validation-for="SeverityId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="ReporterId" />
            <select class="form-control select2" asp-for="ReporterId" asp-items="Model.AvailableReporters"></select>
            <span asp-validation-for="ReporterId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-12">
        <div class="mb-3">
            <wc-label asp-for="AssigneeId" />
            <select class="form-control select2" asp-for="AssigneeId" asp-items="Model.AvailableAssignees"></select>
            <span asp-validation-for="AssigneeId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="StatusId" />
            <select class="form-control select2" asp-for="StatusId" asp-items="Model.AvailableStatus"></select>
            <span asp-validation-for="StatusId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="DueDate" />
            <input asp-for="DueDate" class="form-control datepicker" autocomplete="off" type="text" maxlength="15" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="SprintId" />
            <select class="form-control select2" asp-for="SprintId" asp-items="Model.AvailableSprints"></select>
            <span asp-validation-for="SprintId" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">
            <wc-label asp-for="ParentId" />
            <select class="form-control select2" asp-for="ParentId"></select>
            <span asp-validation-for="ParentId" class="text-danger"></span>
        </div>
    </div>
</div>
@await Component.InvokeAsync("CustomFields", new { backLogId = Model.Id, placement = CustomFieldPlacementEnum.StatusSection })
@* server values for backlog-form-status.js (loaded by the parent Create/Edit page) *@
<div id="backlog-status-config" class="d-none"
     data-modules-url="@Url.Action("GetModules", "Module")"
     data-sub-modules-url="@Url.Action("GetSubModules", "SubModule")"
     data-avatar-url="@Url.Action("GetAvatar", "Profile")"></div>