@model ErrorModel
@{
    ViewData["Title"] = Localize("ErrorPage.Title");
}
<wp-empty-state icon="fas fa-triangle-exclamation" size="page" tone="warning" heading="@Localize("EmptyState.Error.Title").Text" text="@Localize("EmptyState.Error.Text").Text"
    action-text="@Localize("EmptyState.TryAgain").Text" action-icon="fas fa-rotate-right" action-class="js-reload"
    secondary-text="@Localize("EmptyState.GoDashboard").Text" secondary-url="@Url.Content("~/")">
    @if (!string.IsNullOrEmpty(Model.Key))
    {
        <div class="small text-muted">@Localize("EmptyState.Error.Reference").Text: <code>@Model.Key</code></div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <details class="wp-empty__details">
            <summary>@Localize("EmptyState.Error.Details").Text</summary>
            <pre>@Model.Message</pre>
        </details>
    }
</wp-empty-state>
