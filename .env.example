# Copy to .env and edit before running `docker compose up`.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.

# ---- Database ----
# SQL Server requires at least 8 characters with upper case, lower case,
# digits and symbols, or the container will refuse to start.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
MSSQL_DATABASE=Taskist
MSSQL_PORT=1433

# ---- Application ----
TASKIST_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Public address of this install, used in e-mail links, OAuth callbacks and webhook URLs.
APP_BASE_URL=http://localhost:8080/

# Restrict sign-in cookies to HTTPS. The sample stack serves plain HTTP, so this
# defaults to false. Set to true once Taskist sits behind TLS.
TASKIST_REQUIRE_HTTPS_COOKIES=false

# Set to true when a reverse proxy terminates TLS in front of Taskist, so the app
# sees the original scheme and client IP. Only the network below is trusted.
TASKIST_FORWARDED_HEADERS=false
TASKIST_PROXY_NETWORK=172.16.0.0/12

# Encryption keys (Data Protection) are generated on first start and kept in the
# taskist-keys volume. Back that volume up: losing it makes stored Git tokens,
# webhook secrets and notification channel URLs unreadable.

# ---- Seeding ----
# Reference data (roles, permissions, menus, translations, admin account). Leave true for a usable install.
SEED_DATA=true

# Sample client, project and modules, useful for evaluating Taskist. Not for production.
SEED_DUMMY_DATA=false
